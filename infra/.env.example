# Copy to infra/.env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me-0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=lovelly
POSTGRES_USER=lovelly
POSTGRES_PASSWORD=lovelly
DATABASE_URL=postgres://lovelly:lovelly@postgres:5432/lovelly

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=lovelly
MINIO_ROOT_PASSWORD=lovelly-dev-secret
S3_ENDPOINT_URL=http://minio:9000
# Signed URLs for the moderator console (what a browser can reach).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=lovelly
S3_SECRET_KEY=lovelly-dev-secret
S3_BUCKET_PHOTOS=photos
S3_BUCKET_EVIDENCE=evidence

# Apps connect here. On a phone, use your Mac's LAN IP (see README).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://livekit:7880
# IP LiveKit advertises for media; your LAN IP for a phone on Wi-Fi.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-livekit-secret-at-least-32-chars-long
# Read by the livekit container: "<key>: <secret>"
LIVEKIT_KEYS=devkey: dev-livekit-secret-at-least-32-chars-long

# Outside providers: fake until real ones are chosen (docs/questions.md).
PROVIDER_SMS=fake
PROVIDER_IDENTITY=fake
PROVIDER_LIVENESS=fake
PROVIDER_MEDIA=livekit
# Fake selfie check outcome: pass | fail | underage
FAKE_LIVENESS=pass
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

SENTRY_DSN=

# Dev only: e2e suites onboard many users from one IP (production keeps 30/60 per hour).
THROTTLE_OTP_REQUEST=1000/hour
THROTTLE_OTP_VERIFY=1000/hour
